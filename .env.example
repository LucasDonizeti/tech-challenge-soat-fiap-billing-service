# =====================================
# FASE A: Configuração Básica Local
# =====================================

# Spring Boot Configuration
SPRING_PORT=8081
SPRING_APPLICATION_NAME=billing-service
SPRING_APPLICATION_VERSION=0.0.1-SNAPSHOT
LOG_LEVEL=INFO

# MongoDB Configuration (Local)
# For production, store the Atlas connection URI as the MONGODB_ATLAS_URI GitHub Actions secret:
# mongodb+srv://<user>:<url-encoded-password>@<cluster-host>/billing?retryWrites=true&w=majority&appName=billing-service
MONGODB_URI=mongodb://billing_user:billing_password@localhost:27017/billing?authSource=admin
MONGODB_DATABASE=billing

# Messaging Configuration
# Local development: RabbitMQ. AWS deployments: MESSAGING_TYPE=aws
MESSAGING_TYPE=rabbit
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=local
SPRING_RABBITMQ_PASSWORD=local

# AWS Configuration (only needed when MESSAGING_TYPE=aws)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=your-session-token

# AWS SNS topics (required when MESSAGING_TYPE=aws)
# AWS_SNS_TOPIC_COBRANCA_PIX=arn:aws:sns:<region>:<account-id>:<topic-name>
# AWS_SNS_TOPIC_PAGAMENTO_APROVADO=arn:aws:sns:<region>:<account-id>:<topic-name>
# AWS_SNS_TOPIC_PAGAMENTO_RECUSADO=arn:aws:sns:<region>:<account-id>:<topic-name>
# AWS_SQS_QUEUE_ORCAMENTO_PRONTO=<queue-url-or-name>

# Mercado Pago (required for PIX creation and webhook processing)
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# MERCADO_PAGO_WEBHOOK_URL=https://<public-host>/api/v1/billings/webhooks/mercadopago
# BILLING_PIX_EXPIRES_IN_MINUTES=30

# JWT Configuration
JWT_SECRET=mySuperSecretKeyForJWTTokenGenerationThatIsSecureEnough
JWT_EXPIRATION=86400

# Security Configuration
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=secret123

# Features
ENABLE_NEWRELIC=false

# =====================================
# Para usar este arquivo:
# 1. Copiar para .env: cp .env.example .env
# 2. Configurar valores conforme necessário
# 3. Docker Compose lerá automaticamente
# =====================================
