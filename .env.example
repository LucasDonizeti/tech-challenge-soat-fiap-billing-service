# Spring Boot
SPRING_PORT=8082
SPRING_APPLICATION_NAME=billing-service
SPRING_APPLICATION_VERSION=0.0.1-SNAPSHOT
LOG_LEVEL=INFO

# DynamoDB Local (inicie dynamodb e dynamodb-init no Compose central).
DYNAMODB_ENDPOINT=http://localhost:8000

# Mensageria local
MESSAGING_TYPE=rabbit
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=local
SPRING_RABBITMQ_PASSWORD=local

# AWS (em produção, use a role IAM do runtime; não configure chaves estáticas).
# AWS_REGION=us-east-1
# AWS_SNS_TOPIC_COBRANCA_PIX=arn:aws:sns:<region>:<account-id>:<topic-name>
# AWS_SNS_TOPIC_PAGAMENTO_APROVADO=arn:aws:sns:<region>:<account-id>:<topic-name>
# AWS_SNS_TOPIC_PAGAMENTO_RECUSADO=arn:aws:sns:<region>:<account-id>:<topic-name>
# AWS_SQS_QUEUE_ORCAMENTO_PRONTO=<queue-url-or-name>

# Mercado Pago
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# MERCADO_PAGO_BASE_URL=https://<public-host>
# MERCADO_PAGO_SKIP_SIGNATURE_VALIDATION=false
# BILLING_PIX_EXPIRES_IN_MINUTES=30

# JWT e autenticação local
JWT_SECRET=replace-this-with-a-secure-local-secret
JWT_EXPIRATION=86400
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=replace-this-local-password

ENABLE_NEWRELIC=false
